APP_NAME="Algoritmos e Dados"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# ------------------------------------------------------------------ HTTPS
# Precisa começar com https:// em produção e homologação. O Railway (e
# qualquer PaaS) encerra o TLS na borda e entrega HTTP ao container: sem
# isso o Laravel gera links e assets em http e o navegador bloqueia como
# mixed content. Ex.: https://seu-projeto.up.railway.app
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ------------------------------------------------------------------ banco
# Desenvolvimento usa SQLite: é um arquivo, não precisa instalar nada.
DB_CONNECTION=sqlite

# No Railway, troque pelo bloco abaixo e use as variáveis que o plugin de
# MySQL expõe (MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD).
# DB_CONNECTION=mysql
# DB_HOST=${MYSQLHOST}
# DB_PORT=${MYSQLPORT}
# DB_DATABASE=${MYSQLDATABASE}
# DB_USERNAME=${MYSQLUSER}
# DB_PASSWORD=${MYSQLPASSWORD}

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Atrás de HTTPS o cookie de sessão deve ser marcado como seguro.
# Em desenvolvimento fica false, senão o login não funciona no localhost.
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# Envio de alerta entra numa próxima sprint.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@algoritmosedados.com.br"
MAIL_FROM_NAME="${APP_NAME}"
